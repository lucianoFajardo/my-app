      "seed": 412402719,
      "version": 11,
      "versionNonce": 637043199,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775453367099,
      "link": null,
      "locked": false,
      "text": "id uuid primary key default gen_random_uuid(),\n  created_at timestamp with time zone default now(),\n  \n  -- Datos del Cliente\n  name_client text not null,\n  address text not null,\n  phone1 text not null,\n  phone2 text,\n  gps_coords text, -- Aquí puedes guardar \"lat,long\" o el link\n  \n  -- Lógica de Agenda\n  date_instalation date not null,\n  turno turno_instalacion not null, -- Obliga a elegir entre mañana o tarde\n  hour_estimated time without time zone, -- Hora exacta si la tienen\n  \n  -- Estado del trabajo\n  status text not null default 'pendiente', -- 'pendiente', 'completada', 'fallida', 'reprogramada'\n  notas_tecnicas text, -- Muy importante para que el técnico escriba qué pasó\n  \n  -- Auditoría\n  updated_at timestamp with time zone default now()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "id uuid primary key default gen_random_uuid(),\n  created_at timestamp with time zone default now(),\n  \n  -- Datos del Cliente\n  name_client text not null,\n  address text not null,\n  phone1 text not null,\n  phone2 text,\n  gps_coords text, -- Aquí puedes guardar \"lat,long\" o el link\n  \n  -- Lógica de Agenda\n  date_instalation date not null,\n  turno turno_instalacion not null, -- Obliga a elegir entre mañana o tarde\n  hour_estimated time without time zone, -- Hora exacta si la tienen\n  \n  -- Estado del trabajo\n  status text not null default 'pendiente', -- 'pendiente', 'completada', 'fallida', 'reprogramada'\n  notas_tecnicas text, -- Muy importante para que el técnico escriba qué pasó\n  \n  -- Auditoría\n  updated_at timestamp with time zone default now()",
      "autoResize": true,
      "lineHeight": 1.25
    },
