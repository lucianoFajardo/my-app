    {
      "id": "HejzeeqVjVv4-2SwuY0to",
      "type": "text",
      "x": 139.9495954153268,
      "y": 1057.1203873209004,
      "width": 892.059326171875,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
