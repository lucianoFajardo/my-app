export const statusPlanAction = async (clientData: ClientPaymentInfo[]): Promise<ClientPaymentInfo[]> => {
    try {
        const today = new Date();
        // Ajustamos 'today' al final del día para asegurarnos de incluir el día de hoy en las comparaciones
        today.setUTCHours(23, 59, 59, 999);
        // Definimos los días de gracia
        const GRACE_PERIOD_DAYS = 5;
        return clientData.map(client => {
            const monthsDue: string[] = [];
            // 1. Obtenemos el día de facturación sagrado
            const baseParts = client.paymentDate.split('-').map(part => parseInt(part, 10));
            const billingDay = baseParts[2];
            // 2. Determinamos desde dónde empezar a calcular
            let startYear, startMonth;
            if (client.paid_until_date) {
                const paidParts = client.paid_until_date.split('-').map(part => parseInt(part, 10));
                startYear = paidParts[0];
                startMonth = paidParts[1] - 1;
                startMonth++;
                if (startMonth > 11) {
                    startMonth = 0;
                    startYear++;
                }
            } else {
                startYear = baseParts[0];
                startMonth = baseParts[1] - 1;
            }
            // 3. Creamos la fecha iteradora (Fecha de cobro teórica)
            let currentDate = new Date(Date.UTC(startYear, startMonth, billingDay));
            // 4. Bucle con Lógica de Prórroga
            // Iteramos mientras la fecha de cobro sea menor o igual a hoy
            while (currentDate <= today) {
                // Calculamos la fecha límite con prórroga para este mes específico
                const graceLimitDate = new Date(currentDate);
                graceLimitDate.setUTCDate(graceLimitDate.getUTCDate() + GRACE_PERIOD_DAYS);
                // Ajustamos al final del día para ser justos
                graceLimitDate.setUTCHours(23, 59, 59, 999);
                // Solo agregamos a la lista de deudas si HOY ya superó el límite de gracia
                if (today > graceLimitDate) {
                    monthsDue.push(currentDate.toISOString().split('T')[0]);
                }
                // ---------------------------------
                // Avanzamos un mes manualmente
                let nextMonth = currentDate.getUTCMonth() + 1;
                let nextYear = currentDate.getUTCFullYear();
                if (nextMonth > 11) {
                    nextMonth = 0;
                    nextYear++;
                }
                currentDate = new Date(Date.UTC(nextYear, nextMonth, billingDay));
            }
            const planStatus = monthsDue.length > 0 ? "vencido" : "activo";
            return { ...client, monthsDue, planStatus };
        });
    } catch (_) {
        throw new Error("Error al calcular los meses adeudados");
    }
}